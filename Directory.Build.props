<Project>
    <!--
        仓库级版本真相源：宿主与 SDK 共用同一版本号（来源：version.props）
        HostVersion       宿主业务版本 + 插件 SDK 契约版本（同一值，统一发版）
        插件版本           各插件 csproj 内 PluginVersion 自行声明，不在此处统一

        宿主（Launcher / UI / Platforms.*）与 SDK 项目（Generators / Shared）共同 bump，
        确保运行时 PluginSdkContract.CurrentVersion 与宿主程序集版本严格一致。

        版本最终值定义在仓库根 `version.props`（唯一真相源），此处仅负责导入与优先级合并。
        已移除 GitVersion 依赖——发布不再依赖 Git 标签历史，仅凭 version.props 单一文件驱动。

        版本来源优先级（高 → 低）：
          1. MSBuild 属性 /p:HostVersion=...   （build.cs 通过 -host-version 参数传入，CI 手动触发 / 紧急覆盖）
          2. 环境变量 LYBOX_HOST_VERSION        （CI/脚本注入）
          3. version.props 的 <LyboxVersion>    （唯一真相源，本地 / IDE / CI 默认兜底）
    -->
    <PropertyGroup>
        <!-- 所有项目的 bin/obj 统一进入 artifacts/bin 与 artifacts/obj。 -->
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)version.props" />

    <PropertyGroup>
        <!-- 优先级 2：环境变量 LYBOX_HOST_VERSION -->
        <HostVersion Condition="'$(HostVersion)' == '' AND '$(LYBOX_HOST_VERSION)' != ''">$(LYBOX_HOST_VERSION)</HostVersion>
        <!-- 优先级 3：version.props 单一真相源 -->
        <HostVersion Condition="'$(HostVersion)' == ''">$(LyboxVersion)</HostVersion>

        <!-- 向后兼容别名：旧脚本/插件 csproj 仍可用 $(PluginSdkVersion)，
             等价于 $(HostVersion)。不再单独 bump。 -->
        <PluginSdkVersion>$(HostVersion)</PluginSdkVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!--
            AssemblyVersion / FileVersion 必须是纯数字（x.y.z.w），不允许预发布后缀（如 -preview.1）。
            故从 <HostVersion> 派生纯数字版本：丢弃预发布段，得到 major.minor.build.0。
            宿主与 SDK 项目统一在此取值；插件版本由 plugins/Directory.Build.targets 从 <PluginVersion> 另行派生。
        -->
        <_HostVerNoPre>$(HostVersion.Split('-')[0])</_HostVerNoPre>
        <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(_HostVerNoPre.Split('.')[0]).$(_HostVerNoPre.Split('.')[1]).$(_HostVerNoPre.Split('.')[2]).0</AssemblyVersion>
        <FileVersion Condition="'$(FileVersion)' == ''">$(AssemblyVersion)</FileVersion>
    </PropertyGroup>
</Project>
