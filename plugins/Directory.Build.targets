<Project>
    <!--
        插件程序集版本派生（在所有 csproj 之后导入，PluginVersion 此时已可用）。
        AssemblyVersion / FileVersion 必须为纯数字（x.y.z.w），不允许预发布后缀（如 -preview.1），
        故从各插件 csproj 声明的 <PluginVersion> 丢弃预发布段派生 major.minor.build.0。
        <Version> 仍保留完整 SemVer（含预发布），驱动 NuGet 包版本与 InformationalVersion。
    -->
    <PropertyGroup Condition="'$(PluginVersion)' != '' AND '$(PluginVersion)' != '$(HostVersion)'">
        <_PluginVerNoPre>$(PluginVersion.Split('-')[0])</_PluginVerNoPre>
        <AssemblyVersion>$(_PluginVerNoPre.Split('.')[0]).$(_PluginVerNoPre.Split('.')[1]).$(_PluginVerNoPre.Split('.')[2]).0</AssemblyVersion>
        <FileVersion>$(AssemblyVersion)</FileVersion>
    </PropertyGroup>
</Project>