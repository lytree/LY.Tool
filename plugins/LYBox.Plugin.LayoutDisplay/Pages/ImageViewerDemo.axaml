<UserControl
    x:Class="LYBox.Plugin.LayoutDisplay.Pages.ImageViewerDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="clr-namespace:LYBox.Plugin.LayoutDisplay.ViewModels"
    x:DataType="viewModels:ImageViewerDemoViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        RowDefinitions="Auto, *"
        ColumnDefinitions="*,Auto">
        <!-- Main viewer -->
        <u:ImageViewer
            x:Name="Viewer"
            Grid.Row="1"
            Grid.Column="0"
            Source="{Binding Source}"
            Zoom="{Binding Zoom, Mode=TwoWay}"
            OffsetX="{Binding OffsetX, Mode=TwoWay}"
            OffsetY="{Binding OffsetY, Mode=TwoWay}" />

        <!-- Side panel with controls and info -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Width="220"
            Padding="12">
            <StackPanel Spacing="12">
                <u:PathPicker
                    AllowMultiple="False"
                    UsePickerType="OpenFile"
                    DefaultFileExtension="[,.jpg, .png]"
                    ButtonContent="Select"
                    Command="{Binding OpenFileCommand}" />
                <TextBlock
                    Text="ImageViewer Demo"
                    FontSize="16"
                    FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Controls"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="• Drag to pan"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="• Scroll wheel to zoom"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="• Double-click to reset"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Separator />

                <TextBlock
                    Text="{Binding Zoom, StringFormat='Zoom: {0:0.00}×'}"
                    FontWeight="SemiBold" />
                <Slider
                    Minimum="0.1"
                    Maximum="5.0"
                    Value="{Binding Zoom, Mode=TwoWay}" />
                <Slider
                    Minimum="-1000"
                    Maximum="1000"
                    Value="{Binding OffsetX, Mode=TwoWay}" />
                <Slider
                    Minimum="-1000"
                    Maximum="1000"
                    Value="{Binding OffsetY, Mode=TwoWay}" />
                <Button
                    Content="Reset Picture"
                    Command="{Binding ResetImageCommand}" />
                <Button
                    Content="Reset View"
                    Command="{Binding ResetViewCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
