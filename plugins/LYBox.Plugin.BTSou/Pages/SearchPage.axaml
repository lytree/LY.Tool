<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LYBox.Plugin.BTSou.ViewModels"
             x:Class="LYBox.Plugin.BTSou.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 顶部工具栏：搜索框 + 来源库 + 按钮（还原原程序布局） -->
        <Border Grid.Row="0" Padding="12 10" BorderBrush="{DynamicResource AppBackgroundBorderBrush}"
                BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="*,170,120,90,70" ColumnSpacing="8">
                <ComboBox Grid.Column="0" ItemsSource="{Binding SearchHistory}"
                          Text="{Binding Keyword, Mode=TwoWay}"
                          PlaceholderText="请输入关键词" IsEditable="True"
                          MaxDropDownHeight="220"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SourceLibraries}"
                          SelectedItem="{Binding SelectedSource}"/>
                <Button Grid.Column="2" Content="{Binding SearchButtonText}"
                        Command="{Binding SearchCommand}"/>
                <Button Grid.Column="3" Content="下一库"
                        Command="{Binding NextSourceCommand}"/>
                <Button Grid.Column="4" Content="清空"
                        Command="{Binding ClearResultsCommand}"/>
            </Grid>
        </Border>

        <!-- 热搜关键词条 -->
        <Border Grid.Row="1" Padding="12 6">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="热搜:" Classes="Tertiary" VerticalAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding HotWords}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Classes="Link" Padding="2 0"
                                Command="{Binding $parent[ItemsControl].DataContext.HotWordSearchCommand}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </Border>

        <!-- 结果表格（还原原程序 DataGridView 5 列） -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserResizeColumns="True"
                  SelectedItem="{Binding SelectedResult}" Margin="8 4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="3.5*"/>
                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="0.8*"/>
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime}" Width="1*"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="1*"/>
                <DataGridTemplateColumn Header="操作" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="迅雷下载" Padding="8 3" FontSize="12"
                                        Command="{Binding $parent[DataGrid].DataContext.DownloadWithThunderCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="复制" Padding="8 3" FontSize="12"
                                        Command="{Binding $parent[DataGrid].DataContext.CopyLinkCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Padding="12 6" BorderBrush="{DynamicResource AppBackgroundBorderBrush}"
                BorderThickness="0 1 0 0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding StatusText}" Classes="Tertiary" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PoolVersion}" Classes="Tertiary"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
