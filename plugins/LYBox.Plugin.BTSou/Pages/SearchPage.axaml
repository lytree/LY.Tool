<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LYBox.Plugin.BTSou.ViewModels"
             x:Class="LYBox.Plugin.BTSou.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0 0 0 12">
            <TextBlock Text="BTSou 资源搜索" Theme="{StaticResource TitleTextBlock}" Classes="H3" />
            <TextBlock Text="{Binding PoolVersion}" Classes="Secondary" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0 0 0 12">
            <TextBox Grid.Column="0" PlaceholderText="请输入关键词 (Ctrl+C 复制链接)"
                     Text="{Binding Keyword}" />
            <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}"
                    Margin="8 0 0 0" MinWidth="80" />
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="Tertiary"
                       VerticalAlignment="Center" Margin="12 0 0 0"/>
            <TextBlock Grid.Column="3" Text="{Binding LicenseStatus}" Classes="Tertiary"
                       VerticalAlignment="Center" Margin="12 0 0 0"/>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="3*" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="0.8*" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime}" Width="1*" />
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="1*" />
                <DataGridTemplateColumn Header="链接" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="复制磁链" Command="{Binding $parent[DataGrid].DataContext.CopyLinkCommand}"
                                    CommandParameter="{Binding}" Padding="8 4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
