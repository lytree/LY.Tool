<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(MakeConsole)' != 'true'">WinExe</OutputType>
    <OutputType Condition="'$(MakeConsole)' == 'true'">Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <ApplicationIcon>..\..\LYBox.Layout.Ursa\Assets\lybox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Models\**" />
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDI)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="$(AvaloniaDiagnosticsSupport)" />
  </ItemGroup>

  <!--
    ASP.NET Core 共享框架引用：让宿主运行时能加载 Kestrel（WebHostService 依赖）。
    使用 FrameworkReference 而非 Microsoft.NET.Sdk.Web 是为了保留 WinExe 输出类型
    与现有的 Avalonia 桌面应用发布配置不变。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LYBox.Layout.Ursa\LYBox.Layout.Ursa.csproj" />
    <ProjectReference Include="..\..\LYBox.Plugin.Shared\LYBox.Plugin.Shared.csproj" />
  </ItemGroup>

  <!--
    _console.exe 控制台调试版：
    构建/发布时传入 -p:BuildConsoleVariant=true 会在输出目录额外生成
    LYBox.Launcher.Desktop_console.exe（OutputType=Exe，带控制台窗口），
    便于调试时直接观察 ZLogger 日志与异常输出，GUI 版（WinExe）不受影响。
    例：dotnet build -p:BuildConsoleVariant=true
        dotnet publish -p:BuildConsoleVariant=true
  -->
  <Target Name="BuildConsoleVariant" AfterTargets="Build"
          Condition="'$(OutputType)' == 'WinExe' and '$(BuildConsoleVariant)' == 'true' and '$(_ConsoleVariantDone)' != 'true'">
    <PropertyGroup>
      <_ConsoleOutputPath>$(BaseOutputPath)$(Configuration)/console/</_ConsoleOutputPath>
      <_ConsoleIntermediatePath>$(BaseIntermediateOutputPath)console/$(Configuration)/</_ConsoleIntermediatePath>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="MakeConsole=true;BuildConsoleVariant=false;_ConsoleVariantDone=true;OutputPath=$(_ConsoleOutputPath);IntermediateOutputPath=$(_ConsoleIntermediatePath);Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <Copy SourceFiles="$(_ConsoleOutputPath)$(AssemblyName).exe"
          DestinationFiles="$(OutDir)$(AssemblyName)_console.exe"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
